// ==============================================================================
// Scatter-Gather Workflow
// ==============================================================================
// This workflow executes a distributed scatter-gather pipeline:
//
// - l0 (Controller & Gather): Scatters input items across worker nodes (l1, l2, l3),
//   gathers the results back, and executes the post-gather analysis.
// - l1, l2, l3 (Workers): Process scattered items in parallel and send results back to l0.
// ==============================================================================

// ------------------------------------------------------------------------------
// Location l0: Scatter Controller & Gather Node
// ------------------------------------------------------------------------------
<l0, {(p_in1, d_in1), (p_in2, d_in2)},
  exec(s_sc, {(p_in1, d_in1), (p_in2, d_in2)} -> {(p_id, id), (p_group, group)}, {l0})
  .
  (
    !(
      (
        move(id -> p_id, l0, {l1, l2, l3}) .
        move(group -> p_group, l0, {l1, l2, l3})
      )
      +
      (
        send(eof -> p_id, l0, l1) |
        send(eof -> p_id, l0, l2) |
        send(eof -> p_id, l0, l3)
      )
    )
  )
  .
  (
    !(recv(res -> p_res, l1, l0) + recv(eof -> p_res, l1, l0)) |
    !(recv(res -> p_res, l2, l0) + recv(eof -> p_res, l2, l0)) |
    !(recv(res -> p_res, l3, l0) + recv(eof -> p_res, l3, l0))
  )
  .
  exec(s_G, {(p_res, res)} -> {(p_out, d_out)}, {l0})
  .
  exec(s_post, {(p_out, d_out)} -> {(p_report, d_report)}, {l0})
> |

// ------------------------------------------------------------------------------
// Worker Location l1
// ------------------------------------------------------------------------------
<l1, {},
  !(
    (
      recv(id -> p_id, l0, l1) .
      recv(group -> p_group, l0, l1) .
      exec(s_op, {(p_group, group[taskID])} -> {(p_a, a[taskID]), (p_b, b[taskID])}, {l1}) .
      exec(s_work, {(p_id, id[taskID]), (p_a, a[taskID]), (p_b, b[taskID])} -> {(p_res, res)}, {l1}) .
      send(res -> p_res, l1, l0)
    )
    +
    (
      recv(eof -> p_id, l0, l1) .
      send(eof -> p_res, l1, l0)
    )
  )
> |

// ------------------------------------------------------------------------------
// Worker Location l2
// ------------------------------------------------------------------------------
<l2, {},
  !(
    (
      recv(id[taskID] -> p_id, l0, l2) .
      recv(group[taskID] -> p_group, l0, l2) .
      exec(s_op, {(p_group, group[taskID])} -> {(p_a, a[taskID]), (p_b, b[taskID])}, {l2}) .
      exec(s_work, {(p_id, id[taskID]), (p_a, a[taskID]), (p_b, b[taskID])} -> {(p_res, res[taskID])}, {l2}) .
      send(res[taskID] -> p_res, l2, l0)
    )
    +
    (
      recv(eof -> p_id, l0, l2) .
      send(eof -> p_res, l2, l0)
    )
  )
> |

// ------------------------------------------------------------------------------
// Worker Location l3
// ------------------------------------------------------------------------------
<l3, {},
  !(
    (
      recv(id[taskID] -> p_id, l0, l3) .
      recv(group[taskID] -> p_group, l0, l3) .
      exec(s_op, {(p_group, group[taskID])} -> {(p_a, a[taskID]), (p_b, b[taskID])}, {l3}) .
      exec(s_work, {(p_id, id[taskID]), (p_a, a[taskID]), (p_b, b[taskID])} -> {(p_res, res[taskID])}, {l3}) .
      send(res[taskID] -> p_res, l3, l0)
    )
    +
    (
      recv(eof -> p_id, l0, l3) .
      send(eof -> p_res, l3, l0)
    )
  )
>
