<l0, {(p_batches, d_batches)},
  // BEGIN outer scatter: pair root batches and distribute task envelopes.
  (
    //   pair batches into outer-task envelopes
    exec(_s_scatter_0, {(p_batches, d_batches)} -> {(p_task_0, task_0)}, {l0})
    .
    !(
      (
        move(task_0 -> p_task_0, l0, {l0, l2})
      )
      +
      (
        send(eof -> p_task_0, l0, l0)
        |
        send(eof -> p_task_0, l0, l2)
      )
    )
  )
  // END outer scatter
  |
  // BEGIN outer-task replica at l0
  (
    !(
      (
        recv(task_0 -> p_task_0, l0, l0)
        .
        //   open outer task
        exec(_s_open_0, {(p_task_0, task_0)} -> {(p_batch_0, batch[taskID])}, {l0})
        .
        //   BEGIN inner scatter: create child item-task envelopes
        exec(_s_scatter_1, {(p_batch_0, batch[taskID])} -> {(p_task_1, task_1)}, {l0})
        .
        !(
          move(task_1 -> p_task_1, l0, {l1})
        )
        .
        !(
          recv(result_1[taskID] -> p_result_1, l1, l0)
          +
          recv(eof -> p_result_1, l1, l0)
        )
        .
        //   END inner scatter
        //   BEGIN inner gather: turn child results into one outer result
        exec(_s_gather_1, {(p_result_1, result_1[taskID])} -> {(p_result_0, result_0[taskID])}, {l0})
        .
        //   END inner gather; return completed outer result to root gather
        send(result_0[taskID] -> p_result_0, l0, l0)
      )
      +
      (
        recv(eof -> p_task_0, l0, l0)
        .
        send(eof -> p_task_1, l0, l1)
        .
        send(eof -> p_result_0, l0, l0)
      )
    )
  )
  // END outer-task replica at l0
  |
  // BEGIN outer gather: collect completed outer-task results.
  (
    !(
      (
        recv(result_0[taskID] -> p_result_0, l0, l0)
        .
        exec(_s_gather_0, {(p_result_0, result_0[taskID])} -> {(p_output, output)}, {l0})
      )
      +
      (
        recv(eof -> p_result_0, l0, l0)
        .
        recv(result_0[taskID] -> p_result_0, l2, l0)
      )
    )
  )
  // END outer gather
> |

<l1, {},
  // BEGIN l1 inner-worker replica for the l0 outer-task stream
  (
    !(
      (
        recv(task_1 -> p_task_1, l0, l1)
        .
        //   open child task and run the item step
        exec(_s_open_1, {(p_task_1, task_1)} -> {(p_item_1, item[taskID])}, {l1})
        .
        exec(s_echo_item, {(p_item_1, item[taskID])} -> {(p_result_1, result_1[taskID])}, {l1})
        .
        send(result_1[taskID] -> p_result_1, l1, l0)
      )
      +
      (
        recv(eof -> p_task_1, l0, l1)
        .
        send(eof -> p_result_1, l1, l0)
      )
    )
  )
  // END l1 inner-worker replica for l0
  |
  // BEGIN l1 inner-worker replica for the l2 outer-task stream
  (
    !(
      (
        recv(task_1 -> p_task_1, l2, l1)
        .
        //   open child task and run the item step
        exec(_s_open_1, {(p_task_1, task_1)} -> {(p_item_1, item[taskID])}, {l1})
        .
        exec(s_echo_item, {(p_item_1, item[taskID])} -> {(p_result_1, result_1[taskID])}, {l1})
        .
        send(result_1[taskID] -> p_result_1, l1, l2)
      )
      +
      (
        recv(eof -> p_task_1, l2, l1)
        .
        send(eof -> p_result_1, l1, l2)
      )
    )
  )
  // END l1 inner-worker replica for l2
> |

<l2, {},
  // BEGIN outer-task replica at l2
  !(
    (
      recv(task_0 -> p_task_0, l0, l2)
      .
      //   open outer task
      exec(_s_open_0, {(p_task_0, task_0)} -> {(p_batch_0, batch[taskID])}, {l2})
      .
      //   BEGIN inner scatter: create child item-task envelopes
      exec(_s_scatter_1, {(p_batch_0, batch[taskID])} -> {(p_task_1, task_1)}, {l2})
      .
      !(
        move(task_1 -> p_task_1, l2, {l1})
      )
      .
      !(
        recv(result_1[taskID] -> p_result_1, l1, l2)
        +
        recv(eof -> p_result_1, l1, l2)
      )
      .
      //   END inner scatter
      //   BEGIN inner gather: turn child results into one outer result
      exec(_s_gather_1, {(p_result_1, result_1[taskID])} -> {(p_result_0, result_0[taskID])}, {l2})
      .
      //   END inner gather; return completed outer result to root gather
      send(result_0[taskID] -> p_result_0, l2, l0)
    )
    +
    (
      recv(eof -> p_task_0, l0, l2)
      .
      send(eof -> p_task_1, l2, l1)
      .
      send(eof -> p_result_0, l2, l0)
    )
  )
  // END outer-task replica at l2
>
