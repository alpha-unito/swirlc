// Conceptual notation only; not implemented grammar or a translator IR.
// Expansion: 1-nested-scatter.swirl. Inputs are independently dispatched lists.
// scatter_send hides input begin, producer-local dispatch/moves and scoped EOF.
// After explicit input begins, scatter_exec admits matching child occurrences,
// runs ordinary workflow steps at that task ID and sends result begin/data/EOF.
// Its outputs are occurrence streams, not worker-local gathered lists.
// scatter_recv after an explicit result begin drains data/EOF and gathers at
// the consuming dependency location. Helper shape/cardinality rules are retained.

<source_a, {(p_list_a, (d_a, root))},
  scatter_send((d_a, root) -> p_a, source_a, worker)
> |

<source_b, {(p_list_b, (d_b, root))},
  scatter_send((d_b, root) -> p_b, source_b, worker)
> |

<worker, {},
  recv((begin, ?scope_0) -> p_a, source_a, worker)
  .
  recv((begin, ?scope_0) -> p_b, source_b, worker)
  .
  scatter_exec(s_work,
    {U(p_a, stream_a, ?scope_0), U(p_b, stream_b, ?scope_0)}
    -> {U(p_results, results, ?scope_0)}, {worker}, collector)
> |

<collector, {},
  recv((begin, ?scope_0) -> p_results, worker, collector)
  .
  scatter_recv(U(p_results, results, ?scope_0)
    -> {(p_output, (d_output, ?scope_0))}, worker, collector)
  .
  exec(s_consumer, {(p_output, (d_output, ?scope_0))}
    -> {(p_final, (d_final, ?scope_0))}, {collector})
>
