// Outer scatter: l0 keeps one sublist and sends one sublist to l2.

<l0, {(p_input, input)},
  // @compiler begin scatter.dispatch 0
  exec(_s_split_outer, {(p_input, input)} -> {(p_outer_chunk_0, outer_chunk_0), (p_outer_chunk_2, outer_chunk_2)}, {l0})
  .
  send(outer_chunk_2 -> p_outer_chunk_2, l0, l2)
  // @compiler end scatter.dispatch 0
  .
  (
    // @compiler begin scatter.worker 0
    exec(_s_extract_outer_0, {(p_outer_chunk_0, outer_chunk_0)} -> {(p_outer_batches_0, outer_batches_0)}, {l0})
    .
    (
      !(
        (
          exec(_s_take_outer_0, {(p_outer_batches_0, outer_batches_0)} -> {(p_outer_item_0, outer_item_0[outerID])}, {l0})
          .
          exec(s_outer, {(p_outer_item_0, outer_item_0[outerID])} -> {(p_inner_list_0, inner_list_0[outerID])}, {l0})
          .
          // @compiler begin scatter.dispatch 1
          send(inner_list_0[outerID] -> p_inner_list_0, l0, l1)
          // @compiler end scatter.dispatch 1
          .
          // @compiler begin scatter.gather 1
          recv(inner_output_0[outerID] -> p_inner_output_0, l1, l0)
          // @compiler end scatter.gather 1
          .
          exec(_s_put_outer_0, {(p_inner_output_0, inner_output_0[outerID])} -> {(p_outer_results_0, outer_results_0)}, {l0})
        )
        +
        (
          exec(_s_take_outer_0, {(p_outer_batches_0, eof)} -> {(p_outer_item_0, eof)}, {l0})
          .
          send(eof -> p_inner_list_0, l0, l1)
        )
      )
      |
      exec(_s_collect_outer_0, {(p_outer_results_0, outer_results_0)} -> {(p_outer_output_0, outer_output_0)}, {l0})
    )
    // @compiler end scatter.worker 0
    |
    // @compiler begin scatter.gather 0
    (
      recv(outer_output_2 -> p_outer_output_2, l2, l0)
      .
      exec(_s_gather_outer, {(p_outer_output_0, outer_output_0), (p_outer_output_2, outer_output_2)} -> {(p_output, output)}, {l0})
    )
    // @compiler end scatter.gather 0
  )
> |

// l2 handles its outer sublist and uses l1 for every nested scatter.

<l2, {},
  // @compiler begin scatter.worker 0
  recv(outer_chunk_2 -> p_outer_chunk_2, l0, l2)
  .
  exec(_s_extract_outer_2, {(p_outer_chunk_2, outer_chunk_2)} -> {(p_outer_batches_2, outer_batches_2)}, {l2})
  .
  (
    !(
      (
        exec(_s_take_outer_2, {(p_outer_batches_2, outer_batches_2)} -> {(p_outer_item_2, outer_item_2[outerID])}, {l2})
        .
        exec(s_outer, {(p_outer_item_2, outer_item_2[outerID])} -> {(p_inner_list_2, inner_list_2[outerID])}, {l2})
        .
        // @compiler begin scatter.dispatch 1
        send(inner_list_2[outerID] -> p_inner_list_2, l2, l1)
        // @compiler end scatter.dispatch 1
        .
        // @compiler begin scatter.gather 1
        recv(inner_output_2[outerID] -> p_inner_output_2, l1, l2)
        // @compiler end scatter.gather 1
        .
        exec(_s_put_outer_2, {(p_inner_output_2, inner_output_2[outerID])} -> {(p_outer_results_2, outer_results_2)}, {l2})
      )
      +
      (
        exec(_s_take_outer_2, {(p_outer_batches_2, eof)} -> {(p_outer_item_2, eof)}, {l2})
        .
        send(eof -> p_inner_list_2, l2, l1)
      )
    )
    |
    exec(_s_collect_outer_2, {(p_outer_results_2, outer_results_2)} -> {(p_outer_output_2, outer_output_2)}, {l2})
  )
  .
  send(outer_output_2 -> p_outer_output_2, l2, l0)
  // @compiler end scatter.worker 0
> |

// l1 is the sole destination for both nested scatter streams.

<l1, {},
  // @compiler begin scatter.worker 1
  !(
    (
      recv(inner_list_0[outerID] -> p_inner_list_0, l0, l1)
      .
      exec(_s_extract_inner_0, {(p_inner_list_0, inner_list_0[outerID])} -> {(p_inner_batches_0, inner_batches_0[outerID])}, {l1})
      .
      (
        !(
          (
            exec(_s_take_inner_0, {(p_inner_batches_0, inner_batches_0[outerID])} -> {(p_inner_item_0, inner_item_0[innerID])}, {l1})
            .
            exec(s_inner, {(p_inner_item_0, inner_item_0[innerID])} -> {(p_inner_result_0, inner_result_0[innerID])}, {l1})
            .
            exec(_s_put_inner_0, {(p_inner_result_0, inner_result_0[innerID])} -> {(p_inner_results_0, inner_results_0[outerID])}, {l1})
          )
          +
          (
            exec(_s_take_inner_0, {(p_inner_batches_0, eof)} -> {(p_inner_item_0, eof)}, {l1})
          )
        )
        |
        exec(_s_collect_inner_0, {(p_inner_results_0, inner_results_0[outerID])} -> {(p_inner_output_0, inner_output_0[outerID])}, {l1})
      )
      .
      send(inner_output_0[outerID] -> p_inner_output_0, l1, l0)
    )
    +
    recv(eof -> p_inner_list_0, l0, l1)
  )
  // @compiler end scatter.worker 1
  |
  // @compiler begin scatter.worker 1
  !(
    (
      recv(inner_list_2[outerID] -> p_inner_list_2, l2, l1)
      .
      exec(_s_extract_inner_2, {(p_inner_list_2, inner_list_2[outerID])} -> {(p_inner_batches_2, inner_batches_2[outerID])}, {l1})
      .
      (
        !(
          (
            exec(_s_take_inner_2, {(p_inner_batches_2, inner_batches_2[outerID])} -> {(p_inner_item_2, inner_item_2[innerID])}, {l1})
            .
            exec(s_inner, {(p_inner_item_2, inner_item_2[innerID])} -> {(p_inner_result_2, inner_result_2[innerID])}, {l1})
            .
            exec(_s_put_inner_2, {(p_inner_result_2, inner_result_2[innerID])} -> {(p_inner_results_2, inner_results_2[outerID])}, {l1})
          )
          +
          (
            exec(_s_take_inner_2, {(p_inner_batches_2, eof)} -> {(p_inner_item_2, eof)}, {l1})
          )
        )
        |
        exec(_s_collect_inner_2, {(p_inner_results_2, inner_results_2[outerID])} -> {(p_inner_output_2, inner_output_2[outerID])}, {l1})
      )
      .
      send(inner_output_2[outerID] -> p_inner_output_2, l1, l2)
    )
    +
    recv(eof -> p_inner_list_2, l2, l1)
  )
  // @compiler end scatter.worker 1
>
