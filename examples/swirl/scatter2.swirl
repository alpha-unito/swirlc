<l0, {(p_input, input)},
  exec(s_split, {(p_input, input)} -> {(p_chunk_1, chunk_1), (p_chunk_2, chunk_2)}, {l0})
  .
  (
    send(chunk_1 -> p_chunk_1, l0, l1)
    |
    send(chunk_2 -> p_chunk_2, l0, l2)
  )
  .
  (
    recv(output_1 -> p_output_1, l1, l0)
    |
    recv(output_2 -> p_output_2, l2, l0)
  )
  .
  exec(s_merge, {(p_output_1, output_1), (p_output_2, output_2)} -> {(p_output, output)}, {l0})
> |

<l1, {},
  recv(chunk_1 -> p_chunk_1, l0, l1)
  .
  exec(_s_extract_1, {(p_chunk_1, chunk_1)} -> {(p_batches, d_batches)}, {l1})
  .
  (
    !(
      (
        exec(_s_take_1,{(p_batches, d_batches)} -> {(p_item_1, item_1[taskID])}, {l1})
        .
        // questo exec è il workflow vero e proprio da scatterizzare
        exec(s_work, {(p_item_1, item_1[taskID])} -> {(p_result_1, result_1[taskID])}, {l1})
        .
        exec(_s_put_1, {(p_result_1, result_1[taskID])} -> {(p_results_1, results_1)}, {l1})
      )
      +
      (
        exec(_s_take_1, {(p_batches, eof)} -> {(p_item_1, eof)}, {l1})
      )
    )
    |
    exec(s_collect_1, {(p_results_1, results_1)} -> {(p_output_1, output_1)}, {l1})
  )
  .
  send(output_1 -> p_output_1, l1, l0)
> |

<l2, {},
  recv(chunk_2 -> p_chunk_2, l0, l2)
  .
  (
    !(
      (
        exec(_s_take_2, {(p_batches, d_batches)} -> {(p_item_2, item_2[taskID])}, {l2})
        // take({p_batches, d_batches} -> {p_item_2, item_2[taskID]}, {l2})
        .
        exec(s_work, {(p_item_2, item_2[taskID])} -> {(p_result_2, result_2[taskID])}, {l2})
        .
        exec(_s_put_2, {(p_result_2, result_2[taskID])} -> {(p_results_2, results_2)}, {l2})
        // put({p_result_2, result_2[taskID]} -> {p_results_2, results_2}, {l2})
      )
      +
      (
        exec(_s_take_2, {(p_batches, eof)} -> {(p_item_2, eof)}, {l2})
        // take({p_batches, eof} -> {p_item_2, eof}, {l2})
      )
    )
    |
    exec(s_collect_2, {(p_results_2, results_2)} -> {(p_output_2, output_2)}, {l2})
  )
  .
  send(output_2 -> p_output_2, l2, l0)
>