{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "schemas/config/v1.1/config_schema.json",
  "type": "object",
  "$defs": {
    "choice": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "description": "Python expression returning bool. Port values available as local variables (e.g. p1, p2)."
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$",
          "description": "Data type. Base types: (string, int, bool, file, stdout, directory). Generic lists: list[<type>], nestable e.g. list[file], list[list[string]]."
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array"
            }
          ],
          "description": "Value of the data if it is input workflow data. Array when the type is a list."
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ssh",
            "docker",
            "slurm"
          ],
          "description": "It declares how to access the location."
        },
        "hostname": {
          "type": "string",
          "description": "The IP address to connect to."
        },
        "port": {
          "type": "integer",
          "description": "The port on which to open the connection."
        },
        "username": {
          "type": "string",
          "description": "The SSH username for remote locations."
        },
        "sshKey": {
          "type": "string",
          "description": "The SSH private key path for remote locations."
        },
        "checkHostKey": {
          "enum": [true, false, "accept-new"],
          "description": "SSH host key policy. accept-new saves new keys and rejects changed keys."
        },
        "workdir": {
          "type": "string",
          "description": "Path to the working directory."
        },
        "slurm": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "description": "The SLURM service selected from the source deployment configuration."
            },
            "options": {
              "type": "object",
              "description": "SBATCH options for the selected SLURM service.",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              }
            },
            "partition": {
              "type": "string"
            },
            "nodes": {
              "type": "integer",
              "minimum": 1
            },
            "ntasks": {
              "type": "integer",
              "minimum": 1
            },
            "time": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "hostname": {
          "type": "string",
          "description": "The IP address to connect to."
        },
        "port": {
          "type": "integer",
          "description": "The port on which to open the connection."
        },
        "username": {
          "type": "string",
          "description": "The SSH username for remote locations."
        },
        "sshKey": {
          "type": "string",
          "description": "The SSH private key path for remote locations."
        },
        "checkHostKey": {
          "enum": [true, false, "accept-new"],
          "description": "SSH host key policy. accept-new saves new keys and rejects changed keys."
        },
        "outdir": {
          "type": "string",
          "description": "Path to the output directory."
        },
        "workdir": {
          "type": "string",
          "description": "Path to the working directory."
        },
        "connectionType": {
          "type": "string",
          "enum": [
            "ssh",
            "docker",
            "slurm"
          ],
          "description": "It declares how to access to the location."
        },
        "slurm": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "description": "The SLURM service selected from the source deployment configuration."
            },
            "options": {
              "type": "object",
              "description": "SBATCH options for the selected SLURM service.",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              }
            },
            "partition": {
              "type": "string"
            },
            "nodes": {
              "type": "integer",
              "minimum": 1
            },
            "ntasks": {
              "type": "integer",
              "minimum": 1
            },
            "time": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User-friendly step name"
        },
        "type": {
          "type": "string",
          "enum": [
            "scatter_pairer",
            "scatter_open",
            "scatter_gather",
            "scatter_dispatch"
          ],
          "description": "Built-in special operation type"
        },
        "scatterMethod": {
          "type": "string",
          "enum": [
            "dotproduct",
            "flat_crossproduct",
            "nested_crossproduct"
          ],
          "description": "Scatter pairing method for scatter_pairer"
        },
        "scatter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Port names or parameter names to scatter over"
        },
        "scatterPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Input port names to scatter over in scatter_pairer"
        },
        "command": {
          "type": "string",
          "description": "Application which step executes"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "valueFrom": {
                "type": "string"
              },
              "expression": {
                "$ref": "#/$defs/evaluation"
              },
              "position": {
                "type": "integer"
              },
              "prefix": {
                "type": "string"
              },
              "separate": {
                "type": "boolean"
              },
              "shellQuote": {
                "type": "boolean"
              },
              "itemSeparator": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "valueFrom"
                ]
              },
              {
                "required": [
                  "expression"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/output"
            }
          },
          "additionalProperties": false
        },
        "expression": {
          "type": "object",
          "properties": {
            "language": {
              "const": "javascript"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "bindings": {
              "$ref": "#/$defs/expressionBindings"
            },
            "outputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "language",
            "source",
            "outputs"
          ],
          "additionalProperties": false
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shapeFrom": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/dispatchRoute"
              },
              {
                "$ref": "#/$defs/resultRoute"
              }
            ]
          }
        },
        "key": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operation",
            "scope",
            "id"
          ],
          "additionalProperties": false
        },
        "keySpace": {
          "type": "object",
          "properties": {
            "dispatches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "dispatches"
          ],
          "additionalProperties": false
        },
        "collections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              },
              "read": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$",
                "description": "Data type. Base types: (string, int, bool, file, stdout, directory). Generic lists: list[<type>], nestable e.g. list[file], list[list[string]]."
              }
            },
            "required": [
              "name",
              "scope",
              "output",
              "type",
              "read"
            ],
            "additionalProperties": false
          }
        },
        "stdout": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/evaluation"
            }
          ]
        },
        "bindings": {
          "$ref": "#/$defs/expressionBindings"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "expression"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "scatter_dispatch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "inputs",
              "operationId",
              "scope",
              "dimension",
              "dimensions",
              "scatterMethod",
              "routes",
              "key",
              "keySpace",
              "outputs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scatter_gather"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "inputs",
              "outputs",
              "operationId",
              "scope",
              "scatterMethod",
              "shapeFrom",
              "routes",
              "collections"
            ]
          }
        }
      ]
    },
    "dispatchRoute": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "producers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "controller",
        "workers",
        "producers"
      ],
      "additionalProperties": false
    },
    "resultRoute": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "receiver": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "port",
        "source",
        "receiver",
        "scope",
        "operation",
        "output",
        "elementId"
      ],
      "additionalProperties": false
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dataName": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "glob": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/evaluation"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/evaluation"
                      }
                    ]
                  }
                }
              ]
            },
            "readContents": {
              "type": "boolean"
            },
            "evaluate": {
              "$ref": "#/$defs/evaluation"
            }
          },
          "required": [
            "dataName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "type": "object",
              "properties": {
                "payload": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$",
                  "description": "Data type. Base types: (string, int, bool, file, stdout, directory). Generic lists: list[<type>], nestable e.g. list[file], list[list[string]]."
                }
              },
              "required": [
                "payload",
                "id",
                "type"
              ],
              "additionalProperties": false
            },
            "glob": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/evaluation"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/evaluation"
                      }
                    ]
                  }
                }
              ]
            },
            "readContents": {
              "type": "boolean"
            },
            "evaluate": {
              "$ref": "#/$defs/evaluation"
            }
          },
          "required": [
            "binding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "collection": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "elementId": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$",
                  "description": "Data type. Base types: (string, int, bool, file, stdout, directory). Generic lists: list[<type>], nestable e.g. list[file], list[list[string]]."
                }
              },
              "required": [
                "name",
                "scope",
                "elementId",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "collection"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expressionBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {}
          },
          "required": ["value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "object": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/expressionBinding"
              }
            }
          },
          "required": [
            "object"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "context"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expressionBindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_$][\\w$]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expressionBinding"
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "language": {
          "const": "javascript"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "$ref": "#/$defs/expressionBindings"
        }
      },
      "required": [
        "language",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/$defs/dependency"
        }
      },
      "additionalProperties": false
    },
    "locations": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/$defs/location"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/$defs/step"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string"
    },
    "tmpdir": {
      "type": "string"
    },
    "workdir": {
      "type": "string"
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "has_data"
              },
              "port": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "port",
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "expression"
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^(string|int|bool|file|stdout|directory)$|^list\\[.+\\]$"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                "propertyNames": {
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                }
              },
              "bindings": {
                "$ref": "#/$defs/expressionBindings"
              },
              "expression": {
                "$ref": "#/$defs/evaluation"
              }
            },
            "required": [
              "type",
              "inputs",
              "expression"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
